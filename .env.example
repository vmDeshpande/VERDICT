# VERDICT environment configuration
# Copy this file to .env and fill in the values.

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
# PostgreSQL connection string for the development database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://verdict:verdict@localhost:5432/verdict"

# Test database (used by Vitest)
TEST_DATABASE_URL="postgresql://verdict:verdict@localhost:5432/verdict_test"

# AI provider (not used in Phase 0)
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=

# Object storage (not used in Phase 0)
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Legal ingestion (not used in Phase 0)
# LEGAL_INGESTION_ENABLED=false